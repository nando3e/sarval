# Copiar a .env y rellenar valores.
# Desarrollo local: usar en raíz y/o backend/.env, frontend/.env
# Docker / Dokploy: usar en la raíz; docker-compose las pasa a los servicios.

# Puertos en el host (si 3000 o 4000 están ocupados, cambia aquí o en variables Dokploy)
FRONTEND_PORT=3000
BACKEND_PORT=4000

# Backend (obligatorias en producción)
PORT=4000
NODE_ENV=production
SUPERADMIN_USER=admin
SUPERADMIN_PASSWORD=cambiar_en_produccion
JWT_SECRET=clave_secreta_jwt_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# PostgreSQL (incluido en docker-compose)
POSTGRES_USER=sarval
POSTGRES_PASSWORD=sarval_secret
POSTGRES_DB=sarval
# Si usas Postgres del compose: postgres://usuario:password@postgres:5432/sarval
DATABASE_URL=postgres://sarval:sarval_secret@postgres:5432/sarval
